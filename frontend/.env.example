# StudyVault FastAPI Backend Base URL (defaults to http://127.0.0.1:8000)
# No Pinecone or OpenRouter API keys should ever be set on the frontend!
VITE_API_BASE_URL="http://127.0.0.1:8000"

# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side proxy is used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
